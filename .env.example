# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is git-ignored. Never commit a real API key.
# Every setting here is optional: without a .env the app runs with these
# defaults and local-only suggestions.

# ----------------------------------------------------------------------
# Gemini (optional)
# ----------------------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
# Leave it empty and the app still works - suggestions come from the built-in
# engine instead, and the UI says so.
GEMINI_API_KEY=

# Any Gemini chat model. The default is a rolling "-latest" alias on purpose:
# pinned versions get retired and start returning 404. The lite tier is the
# right choice here (~1.3 s vs ~3 s for full flash, same suggestion quality).
# Verify what your key can actually use:  python -m backend.app.scripts.check_gemini
GEMINI_MODEL=gemini-flash-lite-latest

# Give up on the model rather than make the user wait. A late answer is
# harmless - it arrives on the websocket and is dropped if you have typed on.
GEMINI_TIMEOUT_SECONDS=6.0
GEMINI_MAX_OUTPUT_TOKENS=256
GEMINI_TEMPERATURE=0.2

# ----------------------------------------------------------------------
# Model selection
# ----------------------------------------------------------------------
# Which classifier to load. Unset = models/sign_model.pkl (the original).
#   models/sign_model_augmented.pkl      retrained, +2.5 points, 3x faster
#   archive/landmark-v1/sign_model.pkl   the original, frozen
# The augmented model is more confident on live input, which makes the hold
# bar fill faster, so it is the better default for actually typing.
SIGN_MODEL_PATH=

# ----------------------------------------------------------------------
# Recognition and stabilisation
# ----------------------------------------------------------------------
# A frame at or above this confidence counts as one full frame of evidence.
# Live webcam confidence is much lower than the model scores on recorded data,
# so this is deliberately not near 1.0. Raise it if wrong letters appear.
MIN_CONFIDENCE=0.55

# Below this a frame counts for nothing; between the two it counts
# proportionally. This is what keeps the progress bar moving on a decent sign
# instead of sitting at zero.
PARTIAL_CONFIDENCE=0.30

# Evidence needed to type a letter, in full-confidence frames. At 15 fps, 6 is
# about 0.4 s of steady holding. Lower = faster typing, more mistakes.
STABLE_FRAMES=6

# How fast a competing letter's evidence fades. This is the flicker-tolerance
# dial: A and E swap back and forth on this model, and below about 0.7 they
# cancel each other out and nothing is ever typed.
PREDICTION_DECAY=0.8

# Minimum gap between any two typed letters.
COMMIT_COOLDOWN_MS=450

# Extra gap before the SAME letter may be typed again (the "LL" in HELLO).
DUPLICATE_SUPPRESSION_MS=900

# Frames without a confident hand before the held pose is released.
RELEASE_FRAMES=4

# ----------------------------------------------------------------------
# Suggestions
# ----------------------------------------------------------------------
MAX_WORD_SUGGESTIONS=4
MAX_SENTENCE_SUGGESTIONS=3

# Quiet period before a Gemini request is actually sent, so that spelling
# I-W-A-N-T does not fire five requests.
SUGGESTION_DEBOUNCE_MS=350
SUGGESTION_CACHE_SIZE=512
SUGGESTION_CACHE_TTL_SECONDS=900

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------
# Comma-separated. Add your deployment origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
SESSION_TTL_SECONDS=3600
