# Frontend build-time settings. Copy to .env.local to override.
#
# Leave this empty for normal use: the Vite dev server proxies /api, /signs
# and /ws to http://127.0.0.1:8000, and a production build is served by the
# same FastAPI process, so everything is same-origin either way.
#
# Set it only when the frontend is deployed separately from the backend, and
# remember to add that frontend origin to CORS_ORIGINS in the backend .env.
VITE_API_BASE=
